# ==============================================================================
# YouTube Automation Engine - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Content Generation (OpenAI)
# Get key from: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 2. Stock Footage (Pexels API - 100% Free)
# Get free API key from: https://www.pexels.com/api/
# ------------------------------------------------------------------------------
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 & OAuth 2.0 Credentials
# Step 1: Create OAuth Client ID (Desktop App) in Google Cloud Console
# Step 2: Download JSON file or paste its raw content into YOUTUBE_CLIENT_SECRET_JSON
# Step 3: Run `python utils/get_youtube_token.py` to get YOUTUBE_REFRESH_TOKEN
# ------------------------------------------------------------------------------
# Either raw JSON string OR relative/absolute file path:
YOUTUBE_CLIENT_SECRET_JSON={"installed":{"client_id":"YOUR_CLIENT_ID.apps.googleusercontent.com","project_id":"your-project","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"YOUR_CLIENT_SECRET","redirect_uris":["http://localhost"]}}
YOUTUBE_REFRESH_TOKEN=1//04xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. Telemetry & Alerts (Discord / Telegram)
# Create a Webhook URL in Discord Channel Settings > Integrations > Webhooks
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxxxxxxxxxx

# Optional Telegram alerting (leave blank if using Discord):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 5. Monetization & Channel Settings (Optional customizations)
# ------------------------------------------------------------------------------
AMAZON_AFFILIATE_TAG=your_assoc_id-20
VIDIQ_AFFILIATE_ID=your_vidiq_id
VIDEO_NICHE=mind-blowing science and technology facts
TTS_VOICE=en-US-ChristopherNeural
